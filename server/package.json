{
  "name": "arcade-box-server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/index.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test 'test/**/*.test.ts'",
    "test:pg": "node --test 'test-pg/**/*.test.ts'",
    "db:generate": "drizzle-kit generate",
    "cli": "node src/cli.ts",
    "legal": "node scripts/build-legal.ts"
  },
  "dependencies": {
    "drizzle-orm": "0.45.4",
    "jose": "6.2.18",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.6.0",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "0.31.11",
    "typescript": "^7.0.2"
  }
}
