# 서버 앞단 HTTPS. .env의 CADDY_TLS로 인증서 방식을 고른다.
#   tls-auto   (기본) DOMAIN으로 Let's Encrypt 인증서를 자동 발급·갱신한다
#   tls-origin Cloudflare 프록시 뒤. Cloudflare Origin 인증서(certs/origin.pem, certs/origin.key)를 쓴다
#              Cloudflare SSL/TLS 모드는 Full (strict)로 둔다
# DOMAIN=localhost로 띄우면 Caddy 내부 인증서를 쓴다(로컬 확인용).

# 요청한 쪽의 IP — 서버는 IP별로 요청 수를 세고(손님 등록, 로그인), 그 IP를 아래에서 Caddy가 채운 X-Real-IP 하나에서만 읽는다
# (운영 compose의 CLIENT_IP_HEADER=x-real-ip). 배포 방식과 상관없이 같다:
#   - 상대가 Cloudflare 대역(trusted_proxies)이면 Cloudflare가 채운 CF-Connecting-IP의 값
#   - 그 밖(프록시 없이 직접 받는 배포, Cloudflare를 건너뛰고 서버로 바로 온 요청)이면 소켓의 상대 주소
# 앱이 보낸 X-Real-IP·CF-Connecting-IP·X-Forwarded-For는 여기서 덮어쓰이거나 쓰이지 않아서, 지어내도 통하지 않는다.
#
# 아래 대역은 Cloudflare가 공개한 값이다: https://www.cloudflare.com/ips-v4 , https://www.cloudflare.com/ips-v6 (2026-11-26에 받음).
# 대역이 바뀌면 여기를 고친다. 낡으면 새 대역으로 들어온 사용자들이 Cloudflare의 주소 하나로 세어져 한도에 빨리 걸린다.
# Cloudflare의 대역만 적는다: 사설 대역이나 넓은 대역을 더하면 그 주소에서 온 요청이 CF-Connecting-IP를 지어낼 수 있다.
{
	servers {
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP
	}
}

(tls-auto) {
}

(tls-origin) {
	tls /etc/caddy/certs/origin.pem /etc/caddy/certs/origin.key
}

{$DOMAIN} {
	import {$CADDY_TLS:tls-auto}
	encode gzip
	reverse_proxy server:8080 {
		# 위에서 정한 주소로 덮어쓴다 (앱이 보낸 X-Real-IP는 서버에 닿지 않는다)
		header_up X-Real-IP {client_ip}
	}
}
