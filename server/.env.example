# 운영 compose(docker-compose.yml)용. 이 파일을 .env로 복사해 채운다(.env는 git에 올리지 않는다).
# 서버 도메인 — Caddy가 이 이름으로 HTTPS 인증서를 받는다 (예: arcade-api.geonbox.com)
DOMAIN=
# (선택) Cloudflare 프록시 뒤라면 tls-origin, 그리고 certs/origin.pem·origin.key에 Origin 인증서를 둔다
CADDY_TLS=
# DB 비밀번호 — 영문·숫자·-·_만 (예: openssl rand -hex 32)
POSTGRES_PASSWORD=
# (선택) 앱의 origin, 쉼표로 여러 개. 비우면 https://localhost,capacitor://localhost
ALLOWED_ORIGINS=
# 구글 로그인에서 받아들이는 우리 앱의 클라이언트 ID, 쉼표로 여러 개. 비우면 구글 계정 연결이 모두 거절된다
GOOGLE_CLIENT_IDS=
# 게임 묶음 서명의 공개 키 (Ed25519, base64). 비밀값이 아니다. 개인 키는 운영자 컴퓨터에만 둔다
BUNDLE_PUBLIC_KEY=
# (선택) 받아 쓸 서버 이미지. 비우면 이 폴더에서 빌드한 arcade-box-server를 쓴다
SERVER_IMAGE=
