# 운영 compose(docker-compose.yml)용. 이 파일을 .env로 복사해 채운다(.env는 git에 올리지 않는다).
# 서버 도메인 — Caddy가 이 이름으로 HTTPS 인증서를 받는다 (예: arcade-box.duckdns.org)
DOMAIN=
POSTGRES_PASSWORD=
# 앱인토스 콘솔 > 개발 > mTLS 인증서에서 받은 zip을 푼 디렉터리 (저장소 밖, 권한 700 권장)
MTLS_DIR=
# 그 디렉터리 안의 파일 이름 (예: <인증서 이름>_public.crt, <인증서 이름>_private.key)
MTLS_CERT_FILE=
MTLS_KEY_FILE=
# (선택) 받아 쓸 서버 이미지. 비우면 이 폴더에서 빌드한 arcade-box-server를 쓴다
SERVER_IMAGE=
# (선택) 서버 컨테이너를 돌릴 사용자 — 인증서 파일 주인의 uid/gid (기본 1000)
APP_UID=
APP_GID=
